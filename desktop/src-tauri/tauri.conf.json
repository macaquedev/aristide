{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aristide",
  "version": "0.1.0",
  "identifier": "org.aristide.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Aristide", "width": 1280, "height": 800,
      "minWidth": 360, "minHeight": 480, "backgroundColor": "#242424"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": { "active": false, "icon": [] }
}
